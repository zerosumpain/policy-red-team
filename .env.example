# Copy to .env. Only OPENROUTER_API_KEY is needed to run an assessment.

# One key funds every model this build can reach. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL. Without it the targeted-research stage records that it could not
# search, and the run finishes as "completed with gaps" rather than failing.
# https://tavily.com
TAVILY_API_KEY=

# OPTIONAL. The model for the research stage, and the default for every stage,
# since a per-assessment picker cannot yet choose one (see docs/phase-1.md).
# POLICY_RESEARCH_MODEL=anthropic/claude-sonnet-4.5

# OPTIONAL. Assessments are scoped to an owner because the column is NOT NULL and
# the store filters on it — not because anything is being kept out.
# POLICY_OWNER_EMAIL=you@example.com

# OPTIONAL. Where the embedded database and the sealed-run keys live.
# A LOST KEY IS A SHREDDED RUN, by design: back this directory up deliberately.
# POLICY_DATA_DIR=.data/db
# POLICY_SEAL_KEY_DIR=data/policy-keys

# OPTIONAL. Where the server listens. It binds to loopback by DELIBERATELY:
# there is no authentication of any kind, so anyone who can reach the port can
# read every assessment and start new ones against your key.
# POLICY_PORT=5290
# POLICY_HOST=127.0.0.1

# OPTIONAL. Which models the picker offers, comma-separated OpenRouter ids.
# Given a list, it REPLACES the built-in menu rather than adding to it.
# POLICY_MODELS=anthropic/claude-sonnet-4.5,deepseek/deepseek-v4-flash
