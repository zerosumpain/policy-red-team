{
  "name": "policy-red-team",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone adversarial policy analysis — raw TypeScript, Node and React, GOV.UK Design System, local database.",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "a11y": "npm run build:client && node scripts/a11y.mjs",
    "assess": "node build.mjs && node dist/cli.js assess",
    "assess:fixture": "node build.mjs && node dist/cli-fixture.js assess",
    "build": "node build.mjs",
    "build:client": "vite build",
    "cli": "node dist/cli.js",
    "dev": "vite",
    "migrate": "node scripts/migrate.mjs",
    "serve": "node dist/server.js",
    "spike": "node spike/pglite.mjs && node spike/drizzle.mjs && node spike/govuk/build.mjs",
    "start": "node build.mjs && npm run build:client && node dist/server.js",
    "sync": "node scripts/sync-core.mjs",
    "sync:check": "node scripts/sync-core.mjs --check",
    "test": "vitest run",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run a11y && npm run walk",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "walk": "node build.mjs && npm run build:client && node scripts/walk.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "archiver": "^5.3.2",
    "busboy": "^1.6.0",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.45.2",
    "govuk-frontend": "^6.5.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "openai": "^6.32.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.6.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.4",
    "jszip": "3.10.1",
    "pdfkit": "0.18.0",
    "playwright": "^1.61.1",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.0"
  }
}
