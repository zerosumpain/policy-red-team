{
  "name": "policy-red-team",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone adversarial policy analysis — raw TypeScript, Node and React, GOV.UK Design System, local database.",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node scripts/migrate.mjs",
    "sync": "node scripts/sync-core.mjs",
    "sync:check": "node scripts/sync-core.mjs --check",
    "spike": "node spike/pglite.mjs && node spike/drizzle.mjs && node spike/govuk/build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "archiver": "^5.3.2",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.45.2",
    "govuk-frontend": "^6.5.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "openai": "^6.32.0",
    "pdfjs-dist": "^5.4.296",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^26.6.1",
    "@types/pdfkit": "0.17.6",
    "jszip": "3.10.1",
    "pdfkit": "0.18.0",
    "playwright": "^1.61.1",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.0"
  }
}
