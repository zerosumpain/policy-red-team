# npm 10.9's peer resolver crashes on vitest 4.1's optional
# `@vitest/browser-playwright` peer — "Cannot read properties of null (reading
# 'edgesOut')" from arborist's #loadPeerSet, with or without playwright present.
# The dependency graph itself is fine; the resolver is not. Recorded here rather
# than left as a flag someone has to remember, so `npm ci` and CI behave the same
# as a local install. Revisit when npm is next upgraded.
legacy-peer-deps=true
